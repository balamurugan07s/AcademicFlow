# ==============================================================================
# EngineeringHub — Environment Variables Specification
# ==============================================================================
# Rule 5 & 6: Never commit secrets. Document every required variable.
# Copy this file to .env and supply actual values for local development.

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Primary Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engineeringhub?schema=public

# Optional SQLite Database (Fallback for lightweight zero-dependency local dev / test)
# DATABASE_URL=file:./dev.db

# Security & Cryptography (Mandatory in production)
# JWT_SECRET: 32+ character high-entropy string for signing user session JWTs
JWT_SECRET=development_jwt_secret_must_be_changed_in_production_32chars!

# ENCRYPTION_KEY: 64-character (32-byte) hex string for AES-256-GCM OAuth token encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub OAuth Integration (Real integration credentials)
# Create via: GitHub -> Settings -> Developer Settings -> OAuth Apps
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook Security
# Shared secret configured on repository or organization webhooks
GITHUB_WEBHOOK_SECRET=

# Background Worker & Cache (Redis - Optional in MVP, fallback provided)
REDIS_URL=redis://localhost:6379
