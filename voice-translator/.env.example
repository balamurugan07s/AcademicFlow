# Optional Translation Service Configuration
# Defaults to public MyMemory Free API (zero setup required out of the box)

# Choose provider: 'mymemory' (default) | 'libretranslate' | 'openai'
VITE_TRANSLATION_PROVIDER=mymemory

# Optional API key for high-volume translation or private endpoints
VITE_TRANSLATION_API_KEY=

# Custom API endpoint URL (e.g. for self-hosted LibreTranslate or proxy)
VITE_TRANSLATION_API_URL=

# Contact email for MyMemory high-limit tier (allows up to 50,000 words/day free)
VITE_MYMEMORY_EMAIL=
